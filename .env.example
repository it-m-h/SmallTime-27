# SmallTime - Einstellungen fuer den Server. Beim ersten Upload mitladen, bei Updates NICHT ueberschreiben.
NODE_ENV=production
# Oeffentliche Adresse der App, exakt wie im Browser, mit https:// und ohne Schraegstrich am Ende.
# Beispiele: https://zeit.firma.ch  oder lokal  http://localhost:55000
# Die Domain muss zur Lizenz passen.
FRONTEND_ORIGIN=https://smalltime.example.ch
# Geheimer Schluessel fuer Anmeldungen. Ein neuer Wert meldet alle Personen ab.
# Langen Zufallswert eintragen, z.B. mit: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=
# Viele Hostings setzen PORT selbst. Nur eintragen, wenn der Anbieter einen festen Port vorgibt.
# PORT=55000
# Hinter nginx (Plesk) mit HTTPS: beide auf true.
SECURE_COOKIE=true
TRUST_PROXY=true
ENABLE_COMPRESSION=true
BCRYPT_COST=12
